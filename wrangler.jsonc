{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top-level configuration
  "name": "briantschu-com",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "route": {
    "pattern": "briantschu.com/*",
    "zone_name": "briantschu.com"
  },
  "assets": {
    "directory": "./public"
  }
}